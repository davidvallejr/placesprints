# Copie para .env e preencha. NUNCA versione o .env.

# ── Notion (obrigatório para o sync real) ────────────────────────────────
# Crie uma integração interna em https://www.notion.so/my-integrations
# e COMPARTILHE com ela: a base "Assessoria em Gestão" (clientes) e as
# bases "🛠️ Tarefas - {Cliente}" (ou dê acesso à página-mãe que as contém).
NOTION_TOKEN=

# Versão da API. O padrão usa a atual (com data sources); o código faz
# fallback automático para 2022-06-28 quando necessário. Não mude sem motivo.
# NOTION_VERSION=2025-09-03

# ── Camada inteligente (OPCIONAL — sem chave, o resumo executivo é
#    gerado por template determinístico, sem custo de tokens) ─────────────
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

# ── Servidor ──────────────────────────────────────────────────────────────
# PORT=3012

# ── Webhook do Notion (OPCIONAL — sync por evento) ────────────────────────
# WEBHOOK_SECRET=

# ── Integração Mercado Livre (OAuth via botão no Notion) ──────────────────
# Passo a passo completo: README.md → "Integração Mercado Livre"
#
# Domínio público HTTPS por onde os CLIENTES acessam (nunca localhost) —
# um túnel nomeado do Cloudflare, por exemplo. Sem barra no final.
PUBLIC_BASE_URL=

# Client ID/Secret do app criado em developers.mercadolivre.com.br/devcenter
# Redirect URI a cadastrar lá: ${PUBLIC_BASE_URL}/meli/callback
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Chave para cifrar os tokens dos clientes em repouso (gere com: openssl rand -hex 32)
MELI_TOKEN_KEY=

# Segredo para assinar o link "Conectar Mercado Livre" do Notion (gere com: openssl rand -hex 32)
MELI_LINK_SECRET=

# ── Ofertas Estratégicas: imagens por IA (OPCIONAL) ──────────────────────
# Chave do fal.ai (crie em https://fal.ai/dashboard/keys; conta da empresa,
# pré-pago). Sem ela, "gerar imagens" devolve `pendente` — nunca sucesso simulado.
# O servidor lê o .env só ao subir: reinicie depois de preencher.
FAL_KEY=
# Modelo de edição com foto de referência (padrão: fal-ai/nano-banana/edit)
# FAL_MODELO=fal-ai/nano-banana/edit
# Preço por imagem em dólares, copiado da página do modelo em fal.ai/models —
# sem ele o custo aparece como "a confirmar" (o sistema não presume preço)
# FAL_CUSTO_IMAGEM=

# ── Custos por SKU (Bling / Tiny / Planilha Sheets) ───────────────────────
# Spec: docs/integracao-custos-erp-SPEC.md
#
# Chave para cifrar os tokens de ERP, o client_secret dos apps e o segredo do
# webhook da planilha (gere com: openssl rand -hex 32). Defina ANTES de conectar
# o 1º ERP ou gerar o webhook: sem ela o sistema recusa (falha fechado, nunca usa
# chave de desenvolvimento). GUARDE UM BACKUP: perdê-la obriga a reconectar todos
# os ERPs e regerar os webhooks. Redirect URI a cadastrar no app do Bling/Tiny:
# ${PUBLIC_BASE_URL}/erp/callback
ERP_TOKEN_KEY=

# Webhook do Bling (product_supplier.*) como GATILHO de releitura. Desligado
# por padrão até o piloto confirmar o HMAC sobre o corpo cru e que editar o
# custo dispara o evento — a varredura diária é a garantia. 1 = liga.
# PS_BLING_WEBHOOK=0
