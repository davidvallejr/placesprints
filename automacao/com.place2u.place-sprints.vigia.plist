<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vigia EXTERNO do Place Sprints (docs/plano-autogestao.md A1): roda scripts/vigia.sh a cada 5 min, fora do Node e sem abrir o banco.
  Nasce em DRY-RUN (monta o aviso e grava em data/vigia.log); envio real só com VIGIA_ENVIO_LIGADO=1 no .env.
  Instalar/desinstalar: docs/autogestao-instalar.md (launchctl bootstrap / bootout). Saída do launchd vai para /dev/null: o vigia escreve o próprio log, com rotação ≤ 1 MB.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.place2u.place-sprints.vigia</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/davidvallejr/place-sprints/scripts/vigia.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/davidvallejr/place-sprints</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict>
</plist>
